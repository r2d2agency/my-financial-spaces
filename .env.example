# Frontend (inlined no build - precisa estar disponível no build do Docker)
VITE_SUPABASE_URL=http://IP-DO-EASYPANEL:8000
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
VITE_SUPABASE_PROJECT_ID=seu-projeto

# Backend (runtime, server functions)
SUPABASE_URL=http://IP-DO-EASYPANEL:8000
SUPABASE_ANON_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# Conexão Direta com PostgreSQL (Opcional para scripts ou BI)
DATABASE_URL=postgresql://postgres:sua-senha@IP-DO-EASYPANEL:5432/postgres

# AI Provider (OpenAI)
OPENAI_API_KEY=sk-xxxx
