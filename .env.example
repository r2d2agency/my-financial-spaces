# Variáveis de Ambiente para EasyPanel (PostgreSQL Puro)

# Backend (runtime, server functions)
DATABASE_URL=postgres://user:password@host:port/dbname?sslmode=disable

# AI Provider (OpenAI)
OPENAI_API_KEY=sk-xxxx

# App Settings
NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# Superadmin semeado automaticamente na inicialização do banco.
# No primeiro acesso o sistema OBRIGA a troca desta senha padrão.
SUPERADMIN_EMAIL=tnicodemos@gmail.com
SUPERADMIN_PASSWORD=Admin@123
SUPERADMIN_NAME=Super Admin
